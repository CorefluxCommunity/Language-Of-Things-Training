# =============================================================================
# LoT Training Environment Configuration
# =============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
#
# These environment variables configure the Docker Compose services.
# =============================================================================

# =============================================================================
# Local MQTT Broker (Coreflux)
# =============================================================================
LOCAL_BROKER_HOST=localhost
LOCAL_BROKER_PORT=1883
LOCAL_BROKER_USER=admin
LOCAL_BROKER_PASS=coreflux

# =============================================================================
# Public MQTT Broker (Coreflux Cloud)
# =============================================================================
# WARNING: All messages on the public broker are visible to everyone!
# Use only for learning and testing, never for production or sensitive data.
PUBLIC_BROKER_HOST=iot.coreflux.cloud
PUBLIC_BROKER_PORT=1883
PUBLIC_BROKER_TLS_PORT=8883
PUBLIC_BROKER_WS_PORT=5000
PUBLIC_BROKER_WSS_PORT=443

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lot_training
POSTGRES_USER=lot_user
POSTGRES_PASSWORD=lot_training_pass

# =============================================================================
# Secondary MQTT Broker (Mosquitto - for bridge exercises)
# =============================================================================
MOSQUITTO_HOST=localhost
MOSQUITTO_PORT=1884
MOSQUITTO_WS_PORT=9001

# =============================================================================
# OPC UA Factory Simulator
# =============================================================================
OPCUA_HOST=localhost
OPCUA_PORT=4840
OPCUA_ENDPOINT=opc.tcp://localhost:4840

# =============================================================================
# Adminer (Database UI)
# =============================================================================
ADMINER_PORT=8080

# =============================================================================
# Resource Limits (Free Tier)
# =============================================================================
# IMPORTANT: The free version of Coreflux has these limits:
#   MAX_ROUTES=2
#   MAX_ACTIONS=12
#   MAX_MODELS=40
# Delete unused resources before creating new ones during exercises.
